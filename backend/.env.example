NODE_ENV=development
PORT=5000
MONGODB_URI=mongodb+srv://username:password@cluster.mongodb.net/atseen_prelaunch
JWT_SECRET=replace-with-a-long-random-secret
JWT_EXPIRES_IN=2h
COOKIE_NAME=atseen_admin
CLIENT_URL=http://localhost:5173
IP_HASH_SECRET=replace-with-a-random-secret
APPLICATION_COUNT_OFFSET=0

RESEND_API_KEY=
MAIL_FROM=hello@atseen.com
CREATORS_NOTIFY_EMAIL=creators@atseen.com

ADMIN_NAME=Administrator
ADMIN_EMAIL=admin@example.com
ADMIN_PASSWORD=replace-with-a-strong-password
ADMIN_FORCE_UPDATE=false

